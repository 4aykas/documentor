# The editor's half of .gitattributes: LF, UTF-8 and a final newline, so a
# file saved on Windows is the file the repository holds.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
